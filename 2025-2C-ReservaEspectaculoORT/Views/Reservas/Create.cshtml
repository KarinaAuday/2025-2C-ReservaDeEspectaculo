@model _2025_2C_ReservaEspectaculoORT.Models.Reserva

@{
    ViewData["Title"] = "Create";
}


<h4>Usted esta reservando @ViewBag.CantButacas butacas para @ViewBag.Funcion.Descripcion con fecha @ViewBag.Funcion.Fecha</h4>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Activa" value="@true"></input>
            <input type="hidden" asp-for="CantidadButacas" value="@ViewBag.CantButacas"></input>
            <input type="hidden" asp-for="FechaAlta" value=""></input>
            <input type="hidden" asp-for="ClienteId" value="@ViewBag.ClienteId"></input>
            <input type="hidden" asp-for="FuncionId" value="@ViewBag.FuncionId"></input>
            <div class="form-group">
                <input type="submit" value="Confirmar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


<div>
    <a asp-action="Index">Volver al inicio</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
