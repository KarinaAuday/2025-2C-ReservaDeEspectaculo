@model IEnumerable<_2025_2C_ReservaEspectaculoORT.Models.Reserva>
    

<h1>Reservas a futuro</h1>
 

@if (Model == null || !Model.Any())
    {
    <p> @ViewBag.Mensaje</p>
    }
    else
    {
         <ul class="list-group">
        @foreach (var item in Model)
        {
           
                <li class="list-group-item d-flex justify-content-between align-items-start">
                <div class="ms-2 me-auto">
                    <p style="font-size: 20px;">@item.Cliente?.Nombre</p>
                    <p style="font-size: 20px;">@item.Funcion?.Descripcion</p>
                    <p style="font-size: 20px;">Cantidad de butacas @item.CantidadButacas<p/>
                    <img src="@item.Funcion?.Pelicula?.Foto" width="100" height="150" />
               </div>
               </li>
              
     
        }
    </ul>
    }
 