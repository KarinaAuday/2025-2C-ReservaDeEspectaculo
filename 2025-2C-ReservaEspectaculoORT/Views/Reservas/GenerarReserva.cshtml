@model _2025_2C_ReservaEspectaculoORT.Models.Reserva

@{
    ViewData["Title"] = "Generar Reserva";
    var cantButacas = ViewBag.CantButacas;
    var funcion = ViewBag.Funcion;
}

<h1>Datos de la reserva</h1>

<div>
    <h4>Estas reservando para: @funcion.Pelicula.Titulo</h4>
    <ul>
        <li>Cantidad de butacas: @cantButacas</li>
    </ul>
</div>
<div>
    <a asp-action="GenerarReserva" method="post">Confirmar</a>
    <input type="hidden" name="reserva" value="@cantButacas" />
    <a asp-action="Cartelera">Cancelar</a>
</div>
