@model _2025_2C_ReservaEspectaculoORT.Models.Funcion

@{
    ViewData["Title"] = "Create";
    ViewBag.Desc = Model?.Pelicula?.Titulo + " - " + Model?.Sala?.TipoSala?.Nombre;
}

<h1>Create</h1>

<h4>Funcion</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ButacasDisponibles" class="control-label"></label>
                <input asp-for="ButacasDisponibles" class="form-control" />
                <span asp-validation-for="ButacasDisponibles" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Confirmada" /> @Html.DisplayNameFor(model => model.Confirmada)
                </label>
            </div>
            <div class="form-group">
                <input asp-for="Descripcion" type="hidden" name="Descripcion" value="-" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Fecha" class="control-label"></label>
                <input asp-for="Fecha" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PeliculaId" class="control-label">Pelicula</label>
                <select asp-for="PeliculaId" class ="form-control" asp-items="ViewBag.PeliculaId"></select>
            </div>
            <div class="form-group">
                <label asp-for="SalaId" class="control-label">Numero sala</label>
                <select asp-for="SalaId" class ="form-control" asp-items="ViewBag.SalaId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
