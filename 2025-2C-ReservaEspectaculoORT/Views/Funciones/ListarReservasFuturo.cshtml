@model IEnumerable<_2025_2C_ReservaEspectaculoORT.Models.Funcion>
    

<h1>reservasEnFuturo</h1>
<div class="card-group">
   @foreach(var item in Model)
    {
        if (item.Fecha > DateTime.Now.AddDays(7))
        {
            <div class="card">
                <img src="@item.Pelicula.Foto" class="card-img-top" alt="...">
                <div class="card-body">
                    <h5 class="card-title">@item.Pelicula.Titulo</h5>
                    <p class="card-text">@item.Descripcion</p>
                    <a asp-area="" asp-controller="Peliculas" asp-action="Details" asp-route-id="@item.Id">
                        <button class="btn">Mas informacion</button>
                    </a>


                </div>
            </div>
               @foreach (var item2 in item.Reservas)
                {
                  <p>Cantidad de butacas @item2.CantidadButacas</p>
                  <p> id: @item2.Id</p>  
                  <p>Fecha de alta: @item2.FechaAlta</p>
                  <p>Activa: @item2.Activa</p>
                    }
               
            
             
        }
    } 
    </div>
    
