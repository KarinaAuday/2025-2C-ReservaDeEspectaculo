<h1>Reserva</h1>

<form asp-action="Reserva" method="post">
    <div class="form-group">
        <label for="id">Película</label>
        <select id="id" name="id" class="form-control" asp-items="ViewBag.Titulo">
            <option value="">-- Seleccioná una película --</option>
        </select>
    </div>

    <div class="form-group">
        <label for="cantButacas">Cantidad de butacas</label>
        <input type="number" id="cantButacas" name="cantButacas" class="form-control" min="1" required />
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Reservar</button>
</form>

