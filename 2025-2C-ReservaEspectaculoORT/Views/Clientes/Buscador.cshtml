@model List<_2025_2C_ReservaEspectaculoORT.Models.Cliente>

<h1>Resultado de la busqueda</h1>
<br>

@if (!String.IsNullOrEmpty(ViewBag.Mensaje))
{
    <p>@ViewBag.Mensaje</p>
}
@if (Model != null && Model.Count > 0)
{
    <ul class="list-group">
        @foreach (var cliente in Model)
        { 
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <div class="ms-2 me-auto">
                    <p style="font-size: 20px;">@cliente.Nombre @cliente.Apellido</p>

                    @if (cliente.Reservas?.LastOrDefault()?.Funcion.Fecha < DateTime.Now)
                    {
                        cliente.Reservas.LastOrDefault().Activa = false;
                    }
                    @if(cliente.Reservas?.LastOrDefault()?.Activa==true)
                    {
                        <p>No se puede reservar dado que el cliente ya tiene una reserva activa</p>
                    }
                    else
                    {

                        <a class="btn btn-primary" asp-area="" asp-controller="Reservas" asp-action="SeleccionarPelicula">Reservar</a>
                    }
                </div> 
                <a class="btn btn-light" asp-area="" asp-controller="Clientes" asp-action="Details" asp-route-id="@cliente.Id">Mas informacion</a>
            </li>
        }
    </ul>
}