@model IEnumerable<_2025_2C_ReservaEspectaculoORT.Models.Pelicula>

@{
    ViewData["Title"] = "ListarFunciones";
}

<h1>Funciones disponibles</h1>

@foreach (var item in ViewBag.Pelicula.Funciones)
{
    if (item.Fecha < DateTime.Now.AddDays(7) && item.Confirmada && item.ButacasDisponibles >= ViewBag.CantButacas)
    {
        <ul>
            <li>hola</li>
        </ul>
    }    
}