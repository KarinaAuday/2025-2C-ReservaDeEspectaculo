@model _2025_2C_ReservaEspectaculoORT.Models.Pelicula

@{
    ViewData["Title"] = "Details";
    var funcionesDisponibles = Model.Funciones
        .Where(f => f.Fecha < DateTime.Now.AddDays(7)
                 && f.Confirmada)
        .OrderBy(f => f.Fecha)
        .ToList();
}

<h1>Details</h1>

<div>
    <h4>Pelicula</h4>
    <hr />
    <dl class="row">
        <dd class="col-sm-10">
            @Html.DisplayNameFor(model => model.Foto)
        </dd>
        <dt class="col-sm-2">
            <img src="@Model.Foto" class="card-img-top" alt="...">
        </dt>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaLanzamiento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaLanzamiento)
        </dd>
        
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Genero)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Genero)
        </dd>
    </dl>
</div>

@if (funcionesDisponibles.Count == 0)
{
    <p>No hay funciones disponibles en los próximos 7 días</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Sala</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var funcion in funcionesDisponibles)
            {
                <tr>
                    <td>@funcion.Fecha.ToShortDateString()</td>
                    <td>@funcion.Fecha.Hour.ToString() : @funcion.Fecha.Minute.ToString()</td>
                    <td>@funcion.Sala?.Numero (@funcion.Sala?.TipoSala?.Nombre)</td>
                    
                </tr>
            }
        </tbody>
    </table>
}

<a class="btn btn-primary" asp-area="" asp-controller="Reservas" asp-action="SeleccionarPeliculaCartelera" asp-route-idPelicula="@Model.Id">Reservar</a>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
