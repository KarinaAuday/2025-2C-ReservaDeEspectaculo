@model List<_2025_2C_ReservaEspectaculoORT.Models.Pelicula>

<h1>Resultado de la busqueda</h1>
<br>

@if (!String.IsNullOrEmpty(ViewBag.Mensaje))
{
    <p>@ViewBag.Mensaje</p>
}
@if (Model != null && Model.Count > 0)
{
    <ul class="list-group">
        @foreach (var pelicula in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <div class="ms-2 me-auto">
                    <p style="font-size: 20px;">@pelicula.Titulo</p>
                    <img src="@pelicula.Foto" width="100" height="150"/>
                </div>
                    <a class="btn btn-light" asp-area="" asp-controller="Peliculas" asp-action="Details" asp-route-id="@pelicula.Id">Mas informacion</a>
            </li>
        }
    </ul>
}