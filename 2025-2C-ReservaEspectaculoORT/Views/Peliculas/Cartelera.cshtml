@model IEnumerable<_2025_2C_ReservaEspectaculoORT.Models.Pelicula>

<head><title>Cartelera</title></head>

<div class="dropdown">
    <a class="btn btn-secondary dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
        Genero
    </a>

    <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Accion">Accion</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Comedia">Comedia</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Drama">Drama</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Fantasia">Fantasia</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Terror">Terror</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Romance">Romance</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.CienciaFiccion">Ciencia Ficcion</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Suspenso">Suspenso</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Animacion">Animacion</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Documental">Documental</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Familiar">Familiar</a></li>
        <li><a class="dropdown-item" asp-area="" asp-controller="Peliculas" asp-action="CarteleraPorGenero" asp-route-genero="@Genero.Musical">Musical</a></li>
    </ul>
</div>
<div class="card-group">
    @foreach(var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100">
                <img src="@item.Foto" class="card-img-top-cartelera" alt="...">
                <div class="card-body">
                    <h5 class="card-title">@item.Titulo</h5>
                    <p class="card-text">@item.Descripcion</p>
                    
                </div>
               <div class="card-footer bg-transparent">
                    @if(item.FechaLanzamiento >= DateTime.Now.AddDays(7))
                    {
                        <p>Proximamente</p>
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-area="" asp-controller="Reservas" asp-action="SeleccionarPeliculaCartelera" asp-route-idPelicula="@item.Id">Reservar</a>
                    }
                    <a class="btn btn-light me-2" asp-area="" asp-controller="Peliculas" asp-action="Details" asp-route-id="@item.Id">Mas informacion</a>
                </div>     
            </div>
        </div>
    }
</div>
