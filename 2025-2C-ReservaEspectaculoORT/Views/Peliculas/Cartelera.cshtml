@model IEnumerable<_2025_2C_ReservaEspectaculoORT.Models.Pelicula>

<head><title>Cartelera</title></head>

<div class="card-group">
    @foreach(var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100">
                <img src="@item.Foto" class="card-img-top-cartelera" alt="...">
                <div class="card-body">
                    <h5 class="card-title">@item.Titulo</h5>
                    <p class="card-text">@item.Descripcion</p>
                    
                </div>
               <div class="card-footer bg-transparent">
                    <a class="btn btn-light me-2" asp-area="" asp-controller="Peliculas" asp-action="Details" asp-route-id="@item.Id">Mas informacion</a>
                    <a class="btn btn-primary" asp-area="" asp-controller="Reservas" asp-action="SeleccionarButacas" asp-route-idPelicula="@item.Id">Reservar</a>
                </div>     
            </div>
        </div>
    }
</div>
