@model IEnumerable<_2025_2C_ReservaEspectaculoORT.Models.Pelicula>

<head><title>Cartelera</title></head>
<body>
<div class="card-group">
        @foreach(var item in Model)
        {
            <div class="card">
                <img src="@item.Foto" class="card-img-top" alt="...">
                <div class="card-body">
                    <h5 class="card-title">@item.Titulo</h5>
                    <p class="card-text">@item.Descripcion</p>
                    <a asp-area="" asp-controller="Peliculas" asp-action="Details" asp-route-id="@item.Id">
                        <button class="btn">Mas informacion</button>
                    </a>
                </div>
            </div>
        }
</div>
</body>

